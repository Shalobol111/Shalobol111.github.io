# Load trusted deployment secrets with node --env-file=.env server.mjs.
# Bind locally behind the site's HTTPS reverse proxy.
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=
# Turn on only when the trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
LEADS_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=nalogi.pravo26@gmail.com

